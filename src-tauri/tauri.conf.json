{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rayfine",
  "identifier": "app.rayfine.Rayfine",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Rayfine",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "transparent": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default", "updater"],
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/thumbnails/*", "$APPDATA/albums/thumbnails/**"]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["resources", "lensfun_db"],
    "category": "Photography",
    "fileAssociations": [
      {
        "ext": [
          "dng",
          "pro",
          "ari",
          "crw",
          "cr2",
          "cr3",
          "bay",
          "raw",
          "erf",
          "raf",
          "3fr",
          "fff",
          "iiq",
          "kdc",
          "k25",
          "dcs",
          "dcr",
          "mos",
          "rwl",
          "mef",
          "mrw",
          "nef",
          "nrw",
          "orf",
          "rw2",
          "pef",
          "ptx",
          "srw",
          "x3f",
          "arw",
          "srf",
          "sr2",
          "jpg",
          "jpeg",
          "png",
          "gif",
          "bmp",
          "tiff",
          "tif",
          "exr",
          "qoi"
        ],
        "name": "Image",
        "description": "Image file",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3REFGQzUyRjJCNTgxQjcKUldTM2diWHlVdnphWjNmNGM0OVd3UmdDRXREOUlEWTNqUFhCQm51K0puWmxKYXljUnR6YUJkaFAK",
      "endpoints": ["https://github.com/RandazzoMaxime/Rayfine/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "version": "1.6.0"
}
